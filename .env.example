# Te vrednosti NE gredo v repozitorij. Na Vercelu: Project > Settings > Environment Variables.
# Lokalno jih vpišite v datoteko .env.local (ta je v .gitignore).

# Obvezno: API ključ iz resend.com
RESEND_API_KEY=

# Obvezno: e-poštni naslov, kamor prihajajo povpraševanja
CONTACT_TO_EMAIL=

# Neobvezno: pošiljatelj, mora biti na domeni, preverjeni v Resendu
# (privzeto: DIZAIN <onboarding@resend.dev>, kar je samo testni naslov)
CONTACT_FROM_EMAIL=
